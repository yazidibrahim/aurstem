# Replace with your domain for automatic HTTPS (DNS A record must point to the Lightsail static IP,
# and ports 80 + 443 must be open in the Lightsail firewall).
# No domain yet? Use ":80" instead.
aurestem.com, www.aurestem.com {
	root * /var/www/aurestem
	encode zstd gzip

	# /solutions -> solutions.html
	try_files {path} {path}.html {path}/index.html

	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Always revalidate html/css/js (Caddy sends ETags, so unchanged files cost almost nothing)
	@code path *.css *.js *.html /
	header @code Cache-Control "no-cache"
	# Images: 1 hour, then revalidate
	@assets path /assets/* /favicon.png
	header @assets Cache-Control "public, max-age=3600, must-revalidate"

	handle_errors {
		rewrite * /index.html
		file_server
	}
}
